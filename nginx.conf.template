# Default NGINX global settings
user  nginx;
worker_processes  auto;

error_log  /var/log/nginx/error.log notice;
pid        /var/run/nginx.pid;

events {
    worker_connections  1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;


    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for" '
                    'proxied to: $proxy_host$request_uri '
                    'request_uri: $request_uri uri: $uri';
    
    access_log /var/log/nginx/access.log main;

    sendfile        on;
    keepalive_timeout  300;

    # Server configuration for the frontend application and API proxying
    server {
        listen 80;
        client_max_body_size 100M;
        # Serve static files for the frontend application
        location /api/ {
            # Use environment variable for API endpoint (configured via envsubst)
            proxy_pass $API_ENDPOINT;  # Replace with your backend API endpoint
            # Add the Authorization header with the API key
            proxy_set_header "removed" "$API_KEY";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            
            # Proxy timeout settings for long-running AI requests
            proxy_connect_timeout 300s;
            proxy_send_timeout 300s;
            proxy_read_timeout 300s;
        }
        
        location / {
            proxy_set_header Host $http_host;
            root /usr/share/nginx/html;  # Path to your Ionic/React build files
            try_files $uri $uri/ /index.html;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }
    }
}
